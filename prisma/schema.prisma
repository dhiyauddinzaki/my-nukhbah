generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  KEPALA_ASRAMA
  MUSYRIF
  WALI_SANTRI
}

model Profile {
  id                    String             @id @db.Uuid
  displayName           String
  role                  Role
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  rooms                 Room[]             @relation("RoomSupervisor")
  halaqahs              Halaqah[]          @relation("HalaqahTeacher")
  createdJournals       DormJournal[]      @relation("DormJournalCreatedBy")
  updatedJournals       DormJournal[]      @relation("DormJournalUpdatedBy")
  createdWeeklyReviews  DormWeeklyReview[] @relation("WeeklyReviewCreatedBy")
  updatedWeeklyReviews  DormWeeklyReview[] @relation("WeeklyReviewUpdatedBy")
  createdTahfidzEntries TahfidzEntry[]     @relation("TahfidzEntryCreatedBy")
  updatedTahfidzEntries TahfidzEntry[]     @relation("TahfidzEntryUpdatedBy")
}

enum SemesterName {
  GANJIL
  GENAP
}

model AcademicYear {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(9)
  startDate DateTime   @db.Date
  endDate   DateTime   @db.Date
  isActive  Boolean    @default(false)
  semesters Semester[]
}

model Semester {
  id             String             @id @default(uuid()) @db.Uuid
  academicYearId String             @db.Uuid
  name           SemesterName
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  isActive       Boolean            @default(false)
  closedAt       DateTime?
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classrooms     Classroom[]
  rooms          Room[]
  halaqahs       Halaqah[]
  enrollments    Enrollment[]
  dormJournals   DormJournal[]
  weeklyReviews  DormWeeklyReview[]
  tahfidzEntries TahfidzEntry[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, id])
}

model Student {
  id                  String                   @id @default(uuid()) @db.Uuid
  nis                 String                   @unique @db.VarChar(32)
  fullName            String                   @db.VarChar(120)
  enrollments         Enrollment[]
  dormAttendances     DormAttendance[]
  prayerAttendances   PrayerAttendance[]
  dailyPresences      DormDailyPresence[]
  tahajjudAssessments DormTahajjudAssessment[]
  activityAttendances DormActivityAttendance[]
  weeklyAdabScores    DormWeeklyAdabScore[]
  dormViolations      DormViolation[]
  tahfidzEntries      TahfidzEntry[]

  @@index([fullName, id])
}

model Classroom {
  id          String       @id @default(uuid()) @db.Uuid
  semesterId  String       @db.Uuid
  name        String       @db.VarChar(80)
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@unique([semesterId, name])
  @@unique([semesterId, id])
}

model Room {
  id            String             @id @default(uuid()) @db.Uuid
  semesterId    String             @db.Uuid
  name          String             @db.VarChar(80)
  supervisorId  String?            @db.Uuid
  supervisor    Profile?           @relation("RoomSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  semester      Semester           @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  enrollments   Enrollment[]
  dormJournals  DormJournal[]
  weeklyReviews DormWeeklyReview[]

  @@unique([semesterId, name])
  @@unique([semesterId, id])
  @@index([supervisorId, semesterId])
}

model Halaqah {
  id             String         @id @default(uuid()) @db.Uuid
  semesterId     String         @db.Uuid
  name           String         @db.VarChar(80)
  teacherId      String?        @db.Uuid
  teacher        Profile?       @relation("HalaqahTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  semester       Semester       @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  enrollments    Enrollment[]
  tahfidzEntries TahfidzEntry[]

  @@unique([semesterId, name])
  @@unique([semesterId, id])
  @@index([teacherId, semesterId])
}

model Enrollment {
  studentId      String     @db.Uuid
  academicYearId String     @db.Uuid
  semesterId     String     @db.Uuid
  classroomId    String?    @db.Uuid
  roomId         String?    @db.Uuid
  halaqahId      String?    @db.Uuid
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  semester       Semester   @relation(fields: [academicYearId, semesterId], references: [academicYearId, id], onDelete: Restrict)
  classroom      Classroom? @relation(fields: [semesterId, classroomId], references: [semesterId, id], onDelete: Restrict)
  room           Room?      @relation(fields: [semesterId, roomId], references: [semesterId, id], onDelete: Restrict)
  halaqah        Halaqah?   @relation(fields: [semesterId, halaqahId], references: [semesterId, id], onDelete: Restrict)

  @@id([semesterId, studentId])
  @@index([studentId, semesterId])
  @@index([semesterId, classroomId])
  @@index([semesterId, roomId])
  @@index([semesterId, halaqahId])
}

enum DormSession {
  TAHAJJUD
  PAGI
  SEKOLAH
  SORE
  KAJIAN_ADAB
  MALAM
}

enum PrayerName {
  SUBUH
  DZUHUR
  ASHAR
  MAGHRIB
  ISYA
}

enum PrayerStatus {
  MUWAFIQ
  JT
  MF
  ALPHA
  IZIN
  SAKIT
}

enum TahfidzType {
  ZIYADAH
  MURAJAAH
  JUZIYYAH
}

enum TahfidzAssessment {
  BELUM_DINILAI
  LANCAR
  PERLU_ULANG
  LULUS
}

model TahfidzEntry {
  id             String            @id @default(uuid()) @db.Uuid
  academicYearId String            @db.Uuid
  semesterId     String            @db.Uuid
  halaqahId      String            @db.Uuid
  studentId      String            @db.Uuid
  date           DateTime          @db.Date
  type           TahfidzType
  fromSurah      String?           @db.VarChar(80)
  fromAyat       Int?
  toSurah        String?           @db.VarChar(80)
  toAyat         Int?
  lineCount      Int?
  juzNumber      Int?
  assessment     TahfidzAssessment @default(BELUM_DINILAI)
  score          Int?
  note           String?           @db.VarChar(500)
  createdById    String            @db.Uuid
  updatedById    String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  semester       Semester          @relation(fields: [academicYearId, semesterId], references: [academicYearId, id], onDelete: Restrict)
  halaqah        Halaqah           @relation(fields: [semesterId, halaqahId], references: [semesterId, id], onDelete: Restrict)
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdBy      Profile           @relation("TahfidzEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      Profile           @relation("TahfidzEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([semesterId, halaqahId, studentId, date, type])
  @@index([semesterId, halaqahId, date])
  @@index([studentId, date])
  @@index([type, assessment])
}

enum PresenceStatus {
  H
  S
  I
  A
}

enum DormActivity {
  PAGI
  SORE
  MALAM
}

model DormJournal {
  id                  String                   @id @default(uuid()) @db.Uuid
  academicYearId      String                   @db.Uuid
  semesterId          String                   @db.Uuid
  roomId              String                   @db.Uuid
  date                DateTime                 @db.Date
  tahajjudPhotoPath   String?                  @db.VarChar(500)
  pagiPhotoPath       String?                  @db.VarChar(500)
  sorePhotoPath       String?                  @db.VarChar(500)
  malamPhotoPath      String?                  @db.VarChar(500)
  presenceSubmittedAt DateTime?
  tahajjudSubmittedAt DateTime?
  pagiSubmittedAt     DateTime?
  soreSubmittedAt     DateTime?
  malamSubmittedAt    DateTime?
  createdById         String                   @db.Uuid
  updatedById         String                   @db.Uuid
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  semester            Semester                 @relation(fields: [academicYearId, semesterId], references: [academicYearId, id], onDelete: Restrict)
  room                Room                     @relation(fields: [semesterId, roomId], references: [semesterId, id], onDelete: Restrict)
  createdBy           Profile                  @relation("DormJournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           Profile                  @relation("DormJournalUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  attendances         DormAttendance[]
  prayers             PrayerAttendance[]
  dailyPresences      DormDailyPresence[]
  tahajjudAssessments DormTahajjudAssessment[]
  activityAttendances DormActivityAttendance[]

  @@unique([semesterId, roomId, date])
  @@index([semesterId, date])
  @@index([createdById])
}

model DormDailyPresence {
  journalId String         @db.Uuid
  studentId String         @db.Uuid
  status    PresenceStatus
  note      String?        @db.VarChar(500)
  journal   DormJournal    @relation(fields: [journalId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([journalId, studentId])
  @@index([studentId, status])
}

model DormTahajjudAssessment {
  journalId String      @db.Uuid
  studentId String      @db.Uuid
  completed Boolean
  journal   DormJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([journalId, studentId])
}

model DormActivityAttendance {
  journalId String         @db.Uuid
  studentId String         @db.Uuid
  activity  DormActivity
  status    PresenceStatus
  journal   DormJournal    @relation(fields: [journalId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([journalId, studentId, activity])
  @@index([studentId, activity, status])
}

model DormWeeklyReview {
  id                    String                @id @default(uuid()) @db.Uuid
  academicYearId        String                @db.Uuid
  semesterId            String                @db.Uuid
  roomId                String                @db.Uuid
  weekStartDate         DateTime              @db.Date
  adabSubmittedAt       DateTime?
  violationsSubmittedAt DateTime?
  createdById           String                @db.Uuid
  updatedById           String                @db.Uuid
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  semester              Semester              @relation(fields: [academicYearId, semesterId], references: [academicYearId, id], onDelete: Restrict)
  room                  Room                  @relation(fields: [semesterId, roomId], references: [semesterId, id], onDelete: Restrict)
  createdBy             Profile               @relation("WeeklyReviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             Profile               @relation("WeeklyReviewUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  adabScores            DormWeeklyAdabScore[]
  violations            DormViolation[]

  @@unique([semesterId, roomId, weekStartDate])
  @@unique([id, semesterId])
  @@index([semesterId, weekStartDate])
}

model DormWeeklyAdabScore {
  reviewId          String           @db.Uuid
  studentId         String           @db.Uuid
  haqLinafsih       Int
  haqLinafsihNote   String?          @db.VarChar(500)
  haqLisyaikhih     Int
  haqLisyaikhihNote String?          @db.VarChar(500)
  haqLizamilih      Int
  haqLizamilihNote  String?          @db.VarChar(500)
  haqLilMakan       Int
  haqLilMakanNote   String?          @db.VarChar(500)
  haqLilKitab       Int
  haqLilKitabNote   String?          @db.VarChar(500)
  haqLilIlm         Int
  haqLilIlmNote     String?          @db.VarChar(500)
  review            DormWeeklyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([reviewId, studentId])
  @@index([studentId, reviewId])
}

model DormViolation {
  id                  String           @id @default(uuid()) @db.Uuid
  reviewId            String           @db.Uuid
  studentId           String           @db.Uuid
  violationType       String           @db.VarChar(160)
  repetitions         Int
  pointsPerOccurrence Int
  review              DormWeeklyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  student             Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, reviewId])
  @@index([reviewId])
}

model DormAttendance {
  journalId String      @db.Uuid
  studentId String      @db.Uuid
  session   DormSession
  present   Boolean
  journal   DormJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([journalId, studentId, session])
  @@index([studentId, session])
}

model PrayerAttendance {
  journalId String       @db.Uuid
  studentId String       @db.Uuid
  prayer    PrayerName
  status    PrayerStatus
  journal   DormJournal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([journalId, studentId, prayer])
  @@index([studentId, prayer])
}
